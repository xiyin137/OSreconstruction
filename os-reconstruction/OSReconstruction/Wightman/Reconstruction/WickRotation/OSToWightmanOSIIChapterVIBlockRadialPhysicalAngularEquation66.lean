/-- Correct compact angular target family for equation `(6.6)`.  The target
logarithm depends only on the observed imaginary variable `y`; that variable
ranges over the `rho / 4` projection of the partial-convolution support. -/
def physicalAngularEquation66MaskedTargetSet
    (A : Finset (osiiAxisPairIndex d)) :
    Set (Fin k -> osiiAxisPairIndex d -> Complex) :=
  (fun y : Fin (k * (d + 1)) -> Real =>
    Z.physicalAngularMaskedTargetLog (hcenter := hcenter) A
      (fun a => (y a : Complex))) ''
    Metric.closedBall 0 (rho / 4)

end OSIIStep4SynchronizedMultiGapContinuationData

/-- A source-linear angular continuation covering one finite signed-axis mask
on the exact `(6.6)` target family. -/
structure OSIIStep4FullSchwartzAngularEquation66FinsetCoveredData
    (Z : OSIIStep4SynchronizedMultiGapContinuationData d k hrho
      (osiiStep4MultiGapXiHatCenter d k center)
      (osiiStep4MultiGapXiHatCenter_time_lower d k center hcenter))
    (OS : OsterwalderSchraderAxioms d)
    (lgc : OSLinearGrowthCondition d OS)
    (A : Finset (osiiAxisPairIndex d)) where
  continuationData : OSIIStep4FullSchwartzAngularContinuationData
    (hcenter := hcenter) Z OS lgc
  coverage :
    Z.physicalAngularEquation66MaskedTargetSet
        (hcenter := hcenter) A ⊆
      continuationData.carrier

