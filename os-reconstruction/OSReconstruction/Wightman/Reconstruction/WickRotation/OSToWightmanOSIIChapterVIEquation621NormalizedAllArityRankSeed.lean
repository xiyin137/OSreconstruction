/-- The physical intersection in a ranked logarithmic tube is redundant. -/
theorem physicalLogarithmicBase_strictGeneratedAtRank_eq
    (arity depth rank : Nat) :
    osiiPhysicalLogarithmicBase
        (osiiStrictGeneratedLogarithmicBaseAtRank arity depth rank) =
      osiiStrictGeneratedLogarithmicBaseAtRank arity depth rank := by
  apply Set.Subset.antisymm inter_subset_left
  intro x hx
  exact ⟨hx, hx.toStrictGenerated.coordinate_abs_lt_pi_div_two⟩

/-- Every ranked logarithmic tube is real-convex. -/
theorem convex_logarithmicTube_strictGeneratedAtRank
    (arity depth rank : Nat) :
    Convex Real
      (osiiLogarithmicTube
        (osiiStrictGeneratedLogarithmicBaseAtRank arity depth rank)) := by
  rw [osiiLogarithmicTube,
    physicalLogarithmicBase_strictGeneratedAtRank_eq]
  exact SCV.tubeDomain_convex
    (convex_osiiStrictGeneratedLogarithmicBaseAtRank arity depth rank)

/-- Zero belongs to every ranked logarithmic tube. -/
theorem zero_mem_logarithmicTube_strictGeneratedAtRank
    (arity depth rank : Nat) :
    (0 : Fin arity -> Complex) ∈
      osiiLogarithmicTube
        (osiiStrictGeneratedLogarithmicBaseAtRank
          arity depth rank) := by
  rw [osiiLogarithmicTube,
    physicalLogarithmicBase_strictGeneratedAtRank_eq]
  change (0 : Fin arity -> Real) ∈
    osiiStrictGeneratedLogarithmicBaseAtRank arity depth rank
  exact OSIIStrictGeneratedLogarithmicArgumentAtRank.scalar_zero_mem
    rank arity depth

/-- A ranked logarithmic tube lies in the complete-normalized pullback when
the unnormalized physical stage realizes the matching ranked carrier.  The
statement includes rank zero and arity zero. -/
theorem logarithmicRankTube_subset_vi2Equation621TotalNormalizedPullback
    (S : SimultaneousTimeContinuationStageLevel d)
    (t depth rank : Nat)
    {epsilon : Real}
    (hepsilon : 0 <= epsilon)
    (rankCarrier_subset : forall arity,
      osiiTimeArgumentCarrier
          (osiiStrictGeneratedLogarithmicBaseAtRank
            arity depth rank) ⊆
        (S.stage arity).carrier) :
    forall arity,
      osiiLogarithmicTube
          (osiiStrictGeneratedLogarithmicBaseAtRank
            arity depth rank) ⊆
        (logarithmicPullbackStage
          ((S.stage arity).vi2Equation621TotalNormalizedStage
            t epsilon)).carrier := by
  intro arity z hz
  change osiiLogExp z ∈
    ((S.stage arity).vi2Equation621TotalNormalizedStage
      t epsilon).carrier
  by_cases harity : 0 < arity
  · apply (S.stage arity
      ).mem_vi2Equation621TotalNormalizedStage_of_mem_vi2NormalizedStage_of_rightHalfPlane
        t hepsilon
    · change osiiVI2Shift arity epsilon (osiiLogExp z) ∈
        (S.stage arity).carrier
      apply rankCarrier_subset arity
      apply osiiVI2Shift_mem_timeArgumentCarrier_of_coordinatewiseSolid
        (strictGeneratedScalarBaseAtRank_isCoordinatewiseSolid
          arity depth rank) hepsilon
      exact osiiLogExp_mem_argumentCarrier hz
    · exact osiiLogExp_mem_rightHalfPlane hz.2
  · rw [(S.stage arity
      ).vi2Equation621TotalNormalizedStage_eq_of_not_pos
        harity t epsilon]
    exact rankCarrier_subset arity (osiiLogExp_mem_argumentCarrier hz)

